---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { tagSlug, postHasTag } from '../../lib/tags';
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const products = await getCollection('products');
  const map = new Map<string, string>();
  posts.forEach((p) => p.data.tags.forEach((t) => map.set(tagSlug(t), t)));
  products.forEach((p) => { if (!map.has(p.data.tag)) map.set(p.data.tag, p.data.tag); });
  return [...map].map(([slug, label]) => ({ params: { tag: slug }, props: { label, slug } }));
}
const { label, slug } = Astro.props;
const posts = (await getCollection('posts')).filter((p) => postHasTag(p.data.tags, slug)).sort((a, b) => +b.data.date - +a.data.date);
const product = (await getCollection('products')).find((p) => p.data.tag === slug);
---
<Base title={`#${label}`} description={`“${label}” etiketiyle ilişkili yazılar.`}>
  <div class="wrap">
    <div class="page-head" data-reveal><span class="eyebrow">Etiket</span><h1>#{label}</h1>
      <p>{posts.length} yazı{product && <> · <a href={`/urunler/${product.id}/`}>{product.data.name} ürün sayfası →</a></>}</p></div>
    {posts.length ? <div class="grid" data-stagger>{posts.map((p) => <PostCard post={p} />)}</div> : <p class="muted">Bu etiketle yazı yok.</p>}
    <div style="height:64px"></div>
  </div>
</Base>
