---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { CATEGORIES, fmtDate } from '../lib/site';
import { tagSlug } from '../lib/tags';
import { productImage } from '../lib/images';
const posts = (await getCollection('posts')).sort((a, b) => +b.data.date - +a.data.date);
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const latest = posts.filter((p) => p.id !== featured.id).slice(0, 6);
const fProduct = products.find((p) => featured.data.tags.some((t) => tagSlug(t) === p.data.tag));
const fImg = fProduct ? productImage(fProduct.id) : null;
const heroIds = ['ghk-cu', 'mk-677', 'kpv-glutatyon'];
const count = (c: string) => posts.filter((p) => p.data.category === c).length;
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div>
        <span class="eyebrow">Bioscience Pharma · Araştırma Notları</span>
        <h1><span class="w" style="--i:0"><span>Ürünlerin</span></span> <span class="w" style="--i:1"><span>arkasındaki</span></span> <span class="w" style="--i:2"><span><em>bilimi</em></span></span> <span class="w" style="--i:3"><span>okuyun</span></span></h1>
        <p class="lead">Her bileşik için hangi reseptöre bağlandığını, hücrede ne yaptığını ve literatürün neyi gösterip neyi göstermediğini yazıyoruz. Doz ya da kullanım önerisi vermiyoruz.</p>
        <div class="hero-actions">
          <a class="btn" href="/urunler/">Ürünlere göz at</a>
          <a class="btn ghost" href="/yazilar/">Yazılar</a>
        </div>
      </div>
      <div class="hero-shelf">
        {heroIds.map((id, i) => {
          const pr = products.find((p) => p.id === id);
          const img = productImage(id);
          return pr && img && (
            <a class={`shelf-item s${i}`} href={`/urunler/${id}/`} data-parallax={[0.06, 0.14, 0.09][i]} aria-label={pr.data.name}>
              <img src={img} alt={pr.data.name} />
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head" data-reveal><div><span class="eyebrow">Ürünler</span><h2>Bioscience Pharma ürün bilgi sayfaları</h2></div><a href="/urunler/">Tümü ({products.length}) →</a></div>
    </div>
    <div class="marquee" data-reveal="blur">
      <div class="marquee-track">
        {[0, 1].map(() => products.map((p) => <ProductCard product={p} />))}
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:8px">
    <div class="wrap">
      <a class="featured" data-reveal="scale" href={`/yazilar/${featured.id}/`}>
        <div class="f-art">{fImg && <img src={fImg} alt={fProduct?.data.name} />}</div>
        <div class="f-body">
          <span class="eyebrow">Son yazı</span>
          <h3>{featured.data.title}</h3>
          <p style="color:var(--ink-2);margin:0">{featured.data.description}</p>
          <div class="muted" style="font-size:14px">{fmtDate(featured.data.date)}</div>
        </div>
      </a>
    </div>
  </section>

  <section class="block" style="padding-top:8px">
    <div class="wrap">
      <div class="section-head" data-reveal><div><h2>Diğer yazılar</h2></div><a href="/yazilar/">Tüm yazılar →</a></div>
      <div class="grid" data-stagger>{latest.map((p) => <PostCard post={p} />)}</div>
    </div>
  </section>

  <section class="block" style="background:var(--paper);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="section-head" data-reveal><div><h2>Konulara göre</h2></div></div>
      <div class="cat-grid" data-stagger>
        {CATEGORIES.map((c) => <a class="cat" href={`/kategori/${c.slug}/`}><b>{c.name}</b><span>{c.blurb}</span><small>{count(c.name)} yazı</small></a>)}
      </div>
    </div>
  </section>
</Base>
