---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroArt from '../components/HeroArt.astro';
import PostCard from '../components/PostCard.astro';
import ProductCard from '../components/ProductCard.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { CATEGORIES, slugOf, fmtDate, readingTime } from '../lib/site';
import { glossary } from '../data/glossary';
const posts = (await getCollection('posts')).sort((a, b) => +b.data.date - +a.data.date);
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured.id).slice(0, 6);
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const count = (c: string) => posts.filter((p) => p.data.category === c).length;
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div>
        <span class="eyebrow">Bilimsel araştırma blogu</span>
        <h1><span class="w" style="--i:0"><span>Moleküllerin</span></span> <span class="w" style="--i:1"><span>arkasındaki</span></span> <span class="w" style="--i:2"><span><em>biyolojiyi</em></span></span> <span class="w" style="--i:3"><span>anlamak</span></span></h1>
        <p class="lead">Araştırma bileşiklerinin hücrede, dokuda ve metabolizmada nasıl etki gösterebileceğini literatür ışığında anlatıyoruz. Kaynaklı, temkinli ve kullanım önerisi içermeden.</p>
        <div class="hero-actions">
          <a class="btn" href="/urunler/">Ürünleri incele</a>
          <a class="btn ghost" href="/yazilar/">Yazıları keşfet</a>
        </div>
        <div class="stats">
          <div><b data-count={posts.length}>0</b><span>kaynaklı yazı</span></div>
          <div><b data-count={products.length}>0</b><span>ürün bilgi sayfası</span></div>
          <div><b data-count={glossary.length}>0</b><span>sözlük terimi</span></div>
          <div><b data-count="0">0</b><span>kullanım önerisi</span></div>
        </div>
      </div>
      <div class="hero-art-wrap" data-parallax="0.12"><HeroArt /></div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[0, 1].map(() => ['Peptit biyolojisi', 'Reseptör sinyalleşmesi', 'Analitik kalite', 'HPLC & kütle spektrometrisi', 'Kaynaklı bilgi', 'Kullanım önerisi yok'].map((t) => <span>{t}</span>))}
    </div>
  </div>

  <section class="block">
    <div class="wrap">
      <div class="section-head" data-reveal><div><span class="eyebrow">Ürünler</span><h2>Bioscience ürün bilgi sayfaları</h2></div><a href="/urunler/">Tümü →</a></div>
    </div>
    <div class="marquee" data-reveal="blur">
      <div class="marquee-track">
        {[0, 1].map(() => products.map((p) => <ProductCard product={p} />))}
      </div>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="section-head" data-reveal><div><span class="eyebrow">Öne çıkan</span><h2>Bu haftanın okuması</h2></div></div>
      <a class="featured" data-reveal="scale" href={`/yazilar/${featured.id}/`}>
        <div class="f-art"><svg viewBox="0 0 200 200" width="170" aria-hidden="true"><g fill="none" stroke="#f5f0e6" stroke-width="5" stroke-linejoin="round" opacity=".92"><path d="M100 30l55 32v64l-55 32-55-32V62z"/><path d="M100 30v64M45 62l55 32M155 62l-55 32" stroke-width="3" opacity=".5"/></g><circle cx="100" cy="94" r="9" fill="#e2b35a"/><circle cx="155" cy="62" r="8" fill="#f5f0e6"/><circle cx="45" cy="126" r="8" fill="#f5f0e6"/></svg></div>
        <div class="f-body">
          <span class="chip" style="align-self:flex-start">{featured.data.category}</span>
          <h3>{featured.data.title}</h3>
          <p style="color:var(--ink-2);margin:0">{featured.data.description}</p>
          <div class="muted" style="font-size:14px">{fmtDate(featured.data.date)} · {featured.data.readingMinutes ?? readingTime(featured.body ?? '')} dk okuma</div>
        </div>
      </a>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="section-head" data-reveal><div><span class="eyebrow">Son yazılar</span><h2>Yeni eklenenler</h2></div><a href="/yazilar/">Tümü →</a></div>
      <div class="grid" data-stagger>{rest.map((p) => <PostCard post={p} />)}</div>
    </div>
  </section>

  <section class="block" style="background:var(--paper);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="section-head" data-reveal><div><span class="eyebrow">Konular</span><h2>Araştırma alanları</h2></div></div>
      <div class="cat-grid" data-stagger>
        {CATEGORIES.map((c) => <a class="cat" href={`/kategori/${c.slug}/`}><b>{c.name}</b><span>{c.blurb}</span><small>{count(c.name)} yazı →</small></a>)}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="max-width:820px" data-reveal><Disclaimer /></div>
  </section>
</Base>
