---
import '../styles/global.css';
import Disclaimer from '../components/Disclaimer.astro';
import { SITE, CATEGORIES } from '../lib/site';
const { title, description = SITE.description, type = 'website', published } = Astro.props;
const full = title ? `${title} · ${SITE.name} ${SITE.tagline}` : `${SITE.name} ${SITE.tagline} — Bilimsel araştırma blogu`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  ['/', 'Ana sayfa'], ['/urunler/', 'Ürünler'], ['/yazilar/', 'Yazılar'], ['/sozluk/', 'Sözlük'], ['/hakkinda/', 'Hakkında'],
];
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/badge-32.png" />
  <link rel="apple-touch-icon" href="/brand/badge-180.png" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <meta property="og:title" content={full} /><meta property="og:description" content={description} />
  <meta property="og:type" content={type} /><meta property="og:locale" content="tr_TR" />
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  <meta name="theme-color" content="#f5f0e6" />
  <script is:inline>
    (function () {
      var d = document.documentElement; d.classList.add('js');
      try {
        if (!sessionStorage.getItem('bs-splash') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('splash-on'); sessionStorage.setItem('bs-splash', '1');
        }
      } catch (e) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <div id="splash" aria-hidden="true">
    <div class="tv"></div>
    <div class="tv-line"></div>
    <div class="tv-scan"></div>
    <div class="tv-brand">
      <img class="tv-logo" src="/brand/logo-full-light.png" alt="Bioscience Pharma" />
      <span>Araştırma Notları</span>
    </div>
    <div class="tv-skip">Geçmek için tıklayın</div>
  </div>
  <a class="skip" href="#main">İçeriğe geç</a>
  <Disclaimer compact />
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/"><img src="/brand/logo-full.png" alt="Bioscience Pharma" width="171" height="50" /><span>{SITE.tagline}</span></a>
      <nav class="nav" id="nav" aria-label="Ana menü">
        {nav.map(([href, label]) => <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div style="display:flex;gap:8px">
        <button class="icon-btn" id="open-search" aria-label="Ara">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="9" r="6"/><path d="M14 14l4 4" stroke-linecap="round"/></svg>
          Ara <kbd>⌘K</kbd>
        </button>
        <button class="icon-btn menu-toggle" id="menu-toggle" aria-label="Menü" aria-expanded="false">☰</button>
      </div>
    </div>
  </header>

  <main id="main"><slot /></main>

  <dialog class="search" id="search-dialog" aria-label="Sitede ara">
    <form method="dialog"><input id="search-input" type="search" placeholder="Bileşik, mekanizma veya konu ara…" autocomplete="off" /></form>
    <ul id="search-results"></ul>
  </dialog>

  <footer class="site-footer">
    <div class="wrap">
      <div class="cols">
        <div>
          <a class="brand" href="/"><img src="/brand/logo-full-light.png" alt="Bioscience Pharma" style="height:66px" /></a>
          <p style="margin-top:14px;max-width:44ch;font-size:15px">{SITE.description}</p>
        </div>
        <div><h4>Konular</h4><ul>{CATEGORIES.map((c) => <li><a href={`/kategori/${c.slug}/`}>{c.name}</a></li>)}</ul></div>
        <div><h4>Site</h4><ul>
          <li><a href="/urunler/">Ürünler</a></li><li><a href="/yazilar/">Tüm yazılar</a></li><li><a href="/sozluk/">Sözlük</a></li>
          <li><a href="/hakkinda/">Editoryal ilke & uyarılar</a></li><li><a href="/rss.xml">RSS</a></li>
          <li><a href={SITE.shop} rel="noopener">Bioscience ürün kataloğu ↗</a></li>
        </ul></div>
      </div>
      <p class="legal">
        Bu sitedeki tüm içerik yalnızca bilimsel bilgilendirme amaçlıdır; tıbbi tavsiye, tanı veya tedavi yerine geçmez ve herhangi bir kullanım, doz ya da protokol önerisi içermez.
        Bahsi geçen araştırma bileşikleri yalnızca laboratuvar araştırması içindir; insan veya hayvan tüketimi için değildir ve bu bileşiklerin çoğu hiçbir sağlık otoritesince ilaç olarak onaylanmamıştır.
        © {new Date().getFullYear()} {SITE.name}.
      </p>
    </div>
  </footer>

  <script>
    import '../scripts/motion.ts';
  </script>
  <script>
    const nav = document.getElementById('nav'); const mt = document.getElementById('menu-toggle');
    mt?.addEventListener('click', () => { const o = nav!.classList.toggle('open'); mt.setAttribute('aria-expanded', String(o)); });

    const dlg = document.getElementById('search-dialog') as HTMLDialogElement;
    const input = document.getElementById('search-input') as HTMLInputElement;
    const list = document.getElementById('search-results')!;
    let index: any[] | null = null; let sel = -1;
    const norm = (s: string) => s.toLocaleLowerCase('tr').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ı/g, 'i');
    async function load() { if (!index) index = await (await fetch('/search.json')).json(); }
    function render(q: string) {
      if (!index) return; const n = norm(q).split(/\s+/).filter(Boolean);
      const hits = n.length ? index.map((p) => {
        const hay = norm([p.title, p.description, p.tags.join(' '), p.compound ?? '', p.category].join(' '));
        const score = n.every((t) => hay.includes(t)) ? n.reduce((a, t) => a + (norm(p.title).includes(t) ? 3 : 1), 0) : 0;
        return { p, score };
      }).filter((x) => x.score).sort((a, b) => b.score - a.score).slice(0, 8) : [];
      list.innerHTML = hits.length ? hits.map(({ p }) => `<li><a href="/yazilar/${p.id}/">${p.title}<small>${p.category} · ${p.description.slice(0, 90)}…</small></a></li>`).join('')
        : (q ? '<li class="empty">Sonuç bulunamadı.</li>' : '<li class="empty">Yazmaya başlayın…</li>');
      sel = -1;
    }
    async function open() { await load(); dlg.showModal(); input.value = ''; render(''); input.focus(); }
    document.getElementById('open-search')?.addEventListener('click', open);
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open(); }
      if (e.key === '/' && !/INPUT|TEXTAREA/.test((e.target as HTMLElement).tagName)) { e.preventDefault(); open(); }
    });
    input.addEventListener('input', () => render(input.value));
    input.addEventListener('keydown', (e) => {
      const items = [...list.querySelectorAll('a')];
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); sel = (sel + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length; items.forEach((a, i) => a.classList.toggle('sel', i === sel)); }
      if (e.key === 'Enter' && items[sel]) { e.preventDefault(); (items[sel] as HTMLAnchorElement).click(); }
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  </script>
</body>
</html>
